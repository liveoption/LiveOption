# Web login token (server-side only; never use a VITE_* variable)
LIVEOPTION_ACCESS_TOKEN=replace_with_random_64_hex_characters

# LiveOption FastAPI Job Server
LIVEOPTION_INTERNAL_SECRET=replace_with_random_64_hex_characters

# Node
NODE_ENV=development

# Server-side upstream URL for API proxy.
LIVEOPTION_UPSTREAM_URL=http://127.0.0.1:19721

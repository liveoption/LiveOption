# Optional operator settings. Copy to .env; never commit filled credentials.
# liveoption setup generates local Web/internal tokens in .liveoption/runtime.env.

# External QFinZero hub. Current public releases require a QFinZero API key.
QFZ_HUB_URL=http://127.0.0.1:19777
QFZ_API_KEY=

# Optional file-based context for the legacy weekly strategy.
# Main Web task news uses the QFinZero ESP API instead.
# LIVEOPTION_NEWS_DIR=.liveoption/data/news
# LIVEOPTION_EARNINGS_DB=.liveoption/data/earnings.sqlite3
# Optional direct service overrides; normally leave unset.
# QFZ_UPQ_URL=http://127.0.0.1:19777/svc/upq
# QFZ_PMB_URL=http://127.0.0.1:19777/svc/pmb
# QFZ_ESP_URL=http://127.0.0.1:19777/svc/esp

# Configure groups/models in Web API settings, or use these environment defaults.
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Optional remote Web client; local Web defaults to port 3001.
LIVEOPTION_WEB_URL=http://127.0.0.1:3001
# LIVEOPTION_ACCESS_TOKEN=your-own-random-token-at-least-32-characters
# LIVEOPTION_INTERNAL_SECRET=another-independent-random-token-at-least-32-characters
